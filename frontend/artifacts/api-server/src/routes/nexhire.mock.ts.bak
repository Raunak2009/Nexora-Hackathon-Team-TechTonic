import { Router, type IRouter } from "express";
import {
  CreateNexhireChatMessageBody,
  CreateNexhireExportBody,
  CreateNexhireJobBody,
  GetNexhireCandidateParams,
  ListNexhireCandidatesQueryParams,
  UpdateNexhireJobBody,
  UpdateNexhireJobParams,
  UpdateNexhireWeightsBody,
  UpdateNexhireWeightsParams,
} from "@workspace/api-zod";

type Job = {
  id: string;
  title: string;
  company: string;
  location: string;
  status: "active" | "draft" | "archived";
  skills: string[];
  semanticWeight: number;
  keywordWeight: number;
  candidateCount: number;
  updatedAt: string;
};

type CandidateSeed = {
  id: string;
  name: string;
  initials: string;
  email: string;
  age: number;
  yearsExperience: number;
  role: string;
  semanticScore: number;
  keywordScore: number;
  confidence: number;
  matchedSkills: string[];
  flagReasons: string[];
  summary: string;
};

